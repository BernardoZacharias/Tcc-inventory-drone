# ==============================================
#  api-node - variaveis de ambiente (TEMPLATE)
#
#  Copie para `.env` e preencha com os valores reais.
#  O `.env` NAO deve ser versionado (ja esta no .gitignore).
#     cp .env.example .env
# ==============================================

PORT=3000

# ----------------------------------------------
#  Banco de dados - PostgreSQL (Supabase)
# ----------------------------------------------
# Forma recomendada: string unica de conexao.
#
#   - Rede IPv4 (a maioria): use o "Session pooler" do Supabase, em
#     Project Settings -> Database -> Connection pooling. O host tem
#     a forma  aws-0-<regiao>.pooler.supabase.com  e o usuario e
#     postgres.<ref-do-projeto>.
#
#   - Rede IPv6: pode usar a conexao direta db.<ref>.supabase.co
#
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres

# Alternativa em pecas (usada apenas se DATABASE_URL estiver ausente)
DB_HOST=aws-0-SUA_REGIAO.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.SEU_REF
DB_PASSWORD=SUA_SENHA
DB_NAME=postgres

# TLS: obrigatorio no Supabase. Use false apenas em Postgres local.
DB_SSL=true

# ----------------------------------------------
#  Autenticacao
# ----------------------------------------------
# Gere um valor longo e aleatorio (ex.: openssl rand -hex 32)
JWT_SECRET=defina_um_segredo_forte_e_aleatorio

# ----------------------------------------------
#  CORS - origem do frontend
# ----------------------------------------------
FRONTEND_URL=http://localhost:5173
