# ──────────────────────────────────────────────
#  Gestock Drone — .gitignore raiz
# ──────────────────────────────────────────────

# Dependências
node_modules/
**/node_modules/

# Artefatos de build do frontend (gerados por `npm run build`)
frontend/dist/
dist/

# Variáveis de ambiente / segredos  ← NUNCA versionar
.env
.env.*
!.env.example
**/.env
!**/.env.example

# Python (vision-python)
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Logs
*.log
npm-debug.log*
logs/

# Sistema operacional
.DS_Store
Thumbs.db

# Editores / IDE
.vscode/
.idea/
*.swp

# Gestock Drone Agent
gestock-drone-agent/.venv/
gestock-drone-agent/**/__pycache__/
gestock-drone-agent/*.db
gestock-drone-agent/*.sqlite3
gestock-drone-agent/dados/
gestock-drone-agent/etiquetas/

# Aplicativo desktop (Electron)
desktop/node_modules/
desktop/dist-app/
